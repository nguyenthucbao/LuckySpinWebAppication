@page "/spin"
@inject HttpClient Http
@inject IJSRuntime JS

<PageTitle>Lucky Spin</PageTitle>

<div class="spin-page">

    @* ── FORM NHẬP ── *@
    @if (!isSpinning && wonPrize == null)
    {
        <div class="form-card">
            <h2>🎰 Lucky Spin</h2>

            <div class="field">
                <label>Mã quay thưởng</label>
                <input @bind="rewardCode" placeholder="Nhập mã của bạn..." />
            </div>

            <div class="field">
                <label>Campaign ID</label>
                <input @bind="campaignId" placeholder="Nhập Campaign ID..." />
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <p class="error">@errorMessage</p>
            }

            <button class="btn-spin" @onclick="StartSpin" disabled="@isSpinning">
                Quay ngay!
            </button>
        </div>
    }

    @* ── VÒNG QUAY ── *@
    @if (isSpinning)
    {
        <div class="wheel-wrapper">
            <div class="wheel @(isSpinning ? "spinning" : "")">
                <div class="segment seg-1">🥇 Nhất</div>
                <div class="segment seg-2">🥈 Nhì</div>
                <div class="segment seg-3">🥉 Ba</div>
            </div>
            <div class="wheel-arrow">▼</div>
            <p class="spin-label">Đang quay...</p>
        </div>
    }

    @* ── POPUP KẾT QUẢ ── *@
    @if (showPopup && wonPrize != null)
    {
        <div class="popup-overlay">
            <div class="popup-card">
                <div class="popup-icon">🎉</div>
                <h3>Chúc mừng!</h3>
                <p class="prize-name">@wonPrize.Name</p>
                <button class="btn-continue" @onclick="ClosePopup">Tiếp tục</button>
            </div>
        </div>
    }

</div>

@code {
    string rewardCode = "";
    string campaignId = "";
    string errorMessage = "";

    bool isSpinning = false;
    bool showPopup = false;

    PrizeResult? wonPrize;

    async Task StartSpin()
    {
        errorMessage = "";

        if (string.IsNullOrWhiteSpace(rewardCode) || string.IsNullOrWhiteSpace(campaignId))
        {
            errorMessage = "Vui lòng nhập đầy đủ mã quay và Campaign ID.";
            return;
        }

        isSpinning = true;
        wonPrize = null;
        StateHasChanged();

        // Giả lập animation 3 giây
        await Task.Delay(3000);

        // Gọi API sau khi animation xong
        var request = new SpinRequest { RewardCode = rewardCode, CampaignId = campaignId };
        var response = await Http.PostAsJsonAsync("api/spin/spinaction", request);

        isSpinning = false;

        if (response.IsSuccessStatusCode)
        {
            var result = await response.Content.ReadFromJsonAsync<SpinResponse>();
            wonPrize = result?.WonPrize;
            showPopup = true;
        }
        else
        {
            var err = await response.Content.ReadFromJsonAsync<ErrorResponse>();
            errorMessage = err?.Message ?? "Có lỗi xảy ra. Vui lòng thử lại.";
        }

        StateHasChanged();
    }

    void ClosePopup()
    {
        showPopup = false;
        wonPrize = null;
        rewardCode = "";
        campaignId = "";
    }

    // ── Models ──────────────────────────────────
    record SpinRequest
    {
        public string RewardCode { get; init; } = "";
        public string CampaignId { get; init; } = "";
    }

    record SpinResponse
    {
        public string RewardCode { get; init; } = "";
        public int RemainingSpins { get; init; }
        public PrizeResult? WonPrize { get; init; }
    }

    record PrizeResult
    {
        public string Id { get; init; } = "";
        public string Name { get; init; } = "";
        public string PrizeType { get; init; } = "";
        public string CampaignId { get; init; } = "";
    }

    record ErrorResponse
    {
        public string Message { get; init; } = "";
    }
}