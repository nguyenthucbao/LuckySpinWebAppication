@page "/customer-info"
@rendermode InteractiveServer
@using LuckySpinFE.Dto
@using System.Text.RegularExpressions
@inject LuckySpinFE.Services.LuckySpinApiClient ApiClient
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="spin-page">
    <div class="card @(showFoundPopup ? "card-dimmed" : "")">
        <div class="card-header">
            <div class="icon-wrap">
                <svg viewBox="0 0 24 24" fill="none" width="26" height="26"><path d="M9 3h6a1 1 0 0 1 1 1v1h1.5A1.5 1.5 0 0 1 19 6.5v13A1.5 1.5 0 0 1 17.5 21h-11A1.5 1.5 0 0 1 5 19.5v-13A1.5 1.5 0 0 1 6.5 5H8V4a1 1 0 0 1 1-1Z" stroke="white" stroke-width="1.6" stroke-linejoin="round" /><path d="M9 5V4h6v1" stroke="white" stroke-width="1.6" stroke-linecap="round" /><path d="M8.5 12h7M8.5 15.5h7M8.5 8.5h4" stroke="white" stroke-width="1.6" stroke-linecap="round" /></svg>
            </div>
            <h2 class="card-title">Thông tin khách hàng</h2>
            <p class="card-sub">Điền thông tin để nhận mã quay thưởng</p>
            <div class="header-accent"></div>
        </div>

        <div class="card-body">
            <div class="field">
                <label>Họ và tên <span class="req">*</span></label>
                <div class="input-wrap">
                    <svg class="field-icon-svg icon-blue" viewBox="0 0 24 24" fill="none"><path d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z" stroke="currentColor" stroke-width="1.7" /><path d="M4.5 20c1.4-3.4 4.3-5.3 7.5-5.3s6.1 1.9 7.5 5.3" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" /></svg>
                    <input @bind="request.FullName" @bind:event="oninput"
                           class="@(submitted && string.IsNullOrWhiteSpace(request.FullName) ? "has-error" : "")"
                           placeholder="Nguyễn Văn A" />
                </div>
                @if (submitted && string.IsNullOrWhiteSpace(request.FullName))
                {
                    <div class="err-hint">⚠ Vui lòng nhập họ tên.</div>
                }
            </div>

            <div class="field">
                <label>Số điện thoại <span class="req">*</span></label>
                <div class="input-wrap">
                    <svg class="field-icon-svg icon-red" viewBox="0 0 24 24" fill="none"><path d="M6.6 10.8c1.3 2.6 3.3 4.6 5.9 5.9l2-2a1 1 0 0 1 1-.25c1.1.36 2.3.56 3.5.56a1 1 0 0 1 1 1V19a1 1 0 0 1-1 1C10.4 20 4 13.6 4 5.5a1 1 0 0 1 1-1H8a1 1 0 0 1 1 1c0 1.2.2 2.4.56 3.5a1 1 0 0 1-.25 1l-2 2Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" /></svg>
                    <input @bind="request.Phone" @bind:event="oninput"
                           class="@(submitted && (string.IsNullOrWhiteSpace(request.Phone) || !IsPhoneValid()) ? "has-error" : "")"
                           placeholder="0901 234 456" />
                </div>

                @* Case 1: Bỏ trống số điện thoại *@
                @if (submitted && string.IsNullOrWhiteSpace(request.Phone))
                {
                    <div class="err-hint">⚠ Vui lòng nhập số điện thoại.</div>
                }
                @* Case 2: Có nhập nhưng chứa ký tự lạ (chữ hoặc ký tự đặc biệt) *@
                else if (!string.IsNullOrWhiteSpace(request.Phone) && !IsPhoneValid())
                {
                    <div class="err-hint">⚠ Số điện thoại không hợp lệ (chỉ được chứa các chữ số).</div>
                }
            </div>

            <div class="field">
                <label>Email <span class="req">*</span></label>
                <div class="input-wrap">
                    <svg class="field-icon-svg icon-blue" viewBox="0 0 24 24" fill="none"><path d="M4 6.5A1.5 1.5 0 0 1 5.5 5h13A1.5 1.5 0 0 1 20 6.5v11A1.5 1.5 0 0 1 18.5 19h-13A1.5 1.5 0 0 1 4 17.5v-11Z" stroke="currentColor" stroke-width="1.6" /><path d="m5 6.5 7 5.5 7-5.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
                    <input @bind="request.Email" @bind:event="oninput"
                           class="@(submitted && string.IsNullOrWhiteSpace(request.Email) ? "has-error" : "")"
                           placeholder="example@gmail.com" />
                </div>
                @if (submitted && string.IsNullOrWhiteSpace(request.Email))
                {
                    <div class="err-hint">⚠ Vui lòng nhập email hợp lệ.</div>
                }
            </div>

            <div class="field">
                <label>Địa chỉ</label>
                <div class="input-wrap">
                    <svg class="field-icon-svg icon-red" viewBox="0 0 24 24" fill="none"><path d="M12 21s7-6.1 7-11.5A7 7 0 0 0 5 9.5C5 14.9 12 21 12 21Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" /><circle cx="12" cy="9.5" r="2.2" stroke="currentColor" stroke-width="1.6" /></svg>
                    <input @bind="request.Address" placeholder="Quận 2, TP.HCM" />
                </div>
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="global-err">@errorMessage</div>
            }

            <button class="btn-submit" @onclick="Submit" disabled="@isLoading">
                @if (isLoading)
                {
                    <span class="spinner"></span>
                    <span>Đang xử lý...</span>
                }
                else
                {
                    <span>Tiếp tục →</span>
                }
            </button>

            <p class="secure-note">
                <svg viewBox="0 0 24 24" fill="none" width="14" height="14"><path d="M12 3l7 3v5c0 4.6-3 8.4-7 10-4-1.6-7-5.4-7-10V6l7-3Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" /><path d="m9 12 2 2 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
                Thông tin của bạn được bảo mật an toàn
            </p>
        </div>
    </div>

    @if (showFoundPopup && respone != null)
    {
        <div class="found-popup-overlay">
            <div class="found-popup">
                <div class="found-icon-wrap">
                    <svg viewBox="0 0 24 24" fill="none" width="26" height="26"><path d="M9.5 12a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7Z" stroke="currentColor" stroke-width="1.6" /><path d="M3.5 19.5c1-2.7 3.3-4.3 6-4.3s5 1.6 6 4.3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /><path d="m16.5 11 1.6 1.6 3-3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
                </div>
                <h3>Số điện thoại này đã kiên kết với một tài khoản</h3>
                <p class="found-sub">Tài khoản liên kết</p>

                <div class="found-info-box">
                    <div class="found-avatar">@GetInitial()</div>
                    <div class="found-details">
                        <strong>@respone.FullName</strong>
                        <span class="found-email">@respone.Email</span>
                        <span class="found-phone">
                            <svg viewBox="0 0 24 24" fill="none" width="12" height="12"><path d="M6.6 10.8c1.3 2.6 3.3 4.6 5.9 5.9l2-2a1 1 0 0 1 1-.25c1.1.36 2.3.56 3.5.56a1 1 0 0 1 1 1V19a1 1 0 0 1-1 1C10.4 20 4 13.6 4 5.5a1 1 0 0 1 1-1H8a1 1 0 0 1 1 1c0 1.2.2 2.4.56 3.5a1 1 0 0 1-.25 1l-2 2Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" /></svg>
                            @respone.Phone
                        </span>
                    </div>
                </div>

                <p class="found-question">Bạn có muốn cập nhật lại thông tin theo tài khoản này không?</p>
                <div class="found-actions">
                    <button class="btn-submit" @onclick="ConfirmUseFoundAccount" disabled="@isLoading">
                        <svg viewBox="0 0 24 24" fill="none" width="16" height="16"><path d="M4 4v5h5M20 20v-5h-5" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /><path d="M5.3 15A8 8 0 0 0 19 12M18.7 9A8 8 0 0 0 5 12" stroke="white" stroke-width="1.8" stroke-linecap="round" /></svg>
                        <span>Có, cập nhật</span>
                    </button>
                    <button class="btn-secondary-found" @onclick="DeclineFoundAccount" disabled="@isLoading">Vui lòng tạo tài khoản mới</button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private bool showFoundPopup = false;

    private PostCustomerRequest request = new();
    private GetAccountByPhoneRespone respone = new();

    private bool accountAlreadyExists = false;

    private bool submitted = false;
    private bool isLoading = false;
    private string errorMessage = "";

    private bool IsPhoneValid()
    {
        if (string.IsNullOrWhiteSpace(request.Phone)) return false;
        // Regex này đảm bảo chuỗi chỉ gồm các chữ số, độ dài từ 9 đến 11 ký tự (chuẩn SĐT Việt Nam)
        return Regex.IsMatch(request.Phone, @"^[0-9]{9,11}$");
    }

    private string GetInitial()
    {
        return string.IsNullOrWhiteSpace(respone?.FullName) ? "?" : respone.FullName.Trim()[0].ToString().ToUpper();
    }

    private async Task Submit()
    {
        submitted = true;

        if (string.IsNullOrWhiteSpace(request.FullName) ||
            string.IsNullOrWhiteSpace(request.Phone) ||
            !IsPhoneValid() ||
            string.IsNullOrWhiteSpace(request.Email))
            return;

        isLoading = true;
        errorMessage = "";

        try
        {
            var foundCustomer = await ApiClient.GetCustomerByPhoneAsync(request.Phone);

            if (foundCustomer != null)
            {
                accountAlreadyExists = true;
                respone.Id = foundCustomer.Id;
                respone.FullName = foundCustomer.FullName;
                respone.Email = foundCustomer.Email;
                respone.Phone = foundCustomer.Phone;
                respone.Address = foundCustomer.Address;

                isLoading = false;
                showFoundPopup = true;
                return;
            }

            await CreateSessionAndNavigate();
        }
        catch (Exception ex)
        {
            errorMessage = $"Lỗi: {ex.Message}";
            isLoading = false;
        }
    }

    private async Task ConfirmUseFoundAccount()
    {
        if (respone == null) return;

        request.FullName = respone.FullName;
        request.Phone = respone.Phone;
        request.Email = respone.Email;
        request.Address = respone.Address;

        showFoundPopup = false;
        await CreateSessionAndNavigate();
    }

    private async Task DeclineFoundAccount()//////////////////////////////////////////////////////////
    {
        showFoundPopup = false;
        // accountAlreadyExists = false;
        // await CreateSessionAndNavigate();
    }

    private async Task CreateSessionAndNavigate()
    {
        isLoading = true;
        errorMessage = "";

        try
        {
            if (accountAlreadyExists)////tìm thấy tk
            {
                await JS.InvokeVoidAsync("localStorage.setItem", "customerId", respone.Id);
                Nav.NavigateTo($"/spin-test?customerId={respone.Id}");
                return;
            }


            var customerId = await ApiClient.CreateWinnerSessionAsync(request);

            await JS.InvokeVoidAsync("localStorage.setItem", "customerId", customerId);

            Nav.NavigateTo($"/spin-test?customerId={customerId}");
        }
        catch (Exception ex)
        {
            errorMessage = $"Lỗi: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
}

<style>
    :global(body), :global(.page), :global(main) {
        margin: 0 !important;
        padding: 0 !important;
        overflow: hidden !important;
    }

    .spin-page {
        --navy: #1e3a8a;
        --navy-light: #3b5bdb;
        --red: #ef4444;
        --orange: #f97316;
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        width: 100vw;
        height: 100vh;
        background: linear-gradient(135deg, #eef2ff 0%, #f8fafc 40%, #fdf2f8 70%, #eff6ff 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1rem;
        overflow: hidden;
        box-sizing: border-box;
    }

        .spin-page::before,
        .spin-page::after {
            content: "";
            position: absolute;
            border-radius: 50%;
            opacity: 0.35;
            pointer-events: none;
            filter: blur(2px);
        }

        .spin-page::before {
            width: 320px;
            height: 320px;
            background: #dbeafe;
            top: -110px;
            left: -110px;
        }

        .spin-page::after {
            width: 260px;
            height: 260px;
            background: #fce7f3;
            bottom: -70px;
            right: -70px;
        }

    .card {
        background: #fff;
        border-radius: 24px;
        width: 100%;
        max-width: 400px;
        box-shadow: 0 15px 40px rgba(30, 41, 82, 0.18);
        position: relative;
        z-index: 1;
        box-sizing: border-box;
        overflow: hidden;
        transition: filter .25s ease, transform .25s ease;
    }

        .card.card-dimmed {
            filter: blur(2px) grayscale(0.35);
            transform: scale(0.96);
        }

    .card-header {
        position: relative;
        text-align: center;
        padding: 1.9rem 2rem 1.6rem;
        background: linear-gradient(135deg, var(--navy) 0%, var(--navy-light) 100%);
    }

    .header-accent {
        position: absolute;
        left: 0;
        right: 0;
        bottom: -4px;
        height: 4px;
        background: linear-gradient(90deg, var(--red), var(--orange));
    }

    .icon-wrap {
        width: 56px;
        height: 56px;
        border-radius: 16px;
        background: rgba(255, 255, 255, 0.18);
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 14px;
        border: 1px solid rgba(255, 255, 255, 0.35);
    }

    .card-title {
        font-size: 22px;
        font-weight: 700;
        letter-spacing: -0.3px;
        margin: 0;
        color: #fff;
    }

    .card-sub {
        font-size: 13px;
        color: rgba(255, 255, 255, 0.8);
        margin: 6px 0 0;
    }

    .card-body {
        padding: 1.75rem 2rem 2rem;
    }

    .field {
        margin-bottom: 1.15rem;
    }

        .field label {
            display: block;
            font-size: 11.5px;
            font-weight: 700;
            letter-spacing: 0.6px;
            text-transform: uppercase;
            color: #8a8fa3;
            margin-bottom: 6px;
        }

    .req {
        color: var(--red);
    }

    .input-wrap {
        position: relative;
    }

    .field-icon-svg {
        position: absolute;
        left: 14px;
        top: 50%;
        transform: translateY(-50%);
        width: 18px;
        height: 18px;
        pointer-events: none;
    }

        .field-icon-svg.icon-blue {
            color: var(--navy);
        }

        .field-icon-svg.icon-red {
            color: var(--red);
        }

    .field input {
        width: 100%;
        height: 46px;
        border: 1.5px solid #e8e9f0;
        border-radius: 12px;
        padding: 0 16px 0 42px;
        font-size: 14.5px;
        color: #222;
        outline: none;
        transition: all .2s ease;
        background: #f7f8fb;
        box-sizing: border-box;
    }

        .field input:focus {
            border-color: var(--navy-light);
            background: #fff;
            box-shadow: 0 0 0 4px rgba(59, 91, 219, 0.12);
        }

        .field input.has-error {
            border-color: var(--red);
            background: #fff8f8;
        }

            .field input.has-error:focus {
                box-shadow: 0 0 0 4px rgba(239, 68, 68, 0.12);
            }

    .err-hint {
        font-size: 12px;
        color: var(--red);
        margin-top: 5px;
        display: flex;
        align-items: center;
        gap: 4px;
        font-weight: 500;
    }

    .global-err {
        font-size: 13px;
        color: var(--red);
        margin: 12px 0;
    }

    .btn-submit {
        width: 100%;
        height: 50px;
        border-radius: 14px;
        border: none;
        background: linear-gradient(100deg, var(--navy-light) 0%, var(--red) 100%);
        color: #fff;
        font-size: 15.5px;
        font-weight: 700;
        cursor: pointer;
        letter-spacing: .3px;
        transition: all .2s ease;
        margin-top: .5rem;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        box-shadow: 0 6px 16px rgba(239, 68, 68, 0.25);
    }

        .btn-submit:hover:not(:disabled) {
            opacity: .95;
            transform: translateY(-1px);
            box-shadow: 0 8px 20px rgba(239, 68, 68, 0.32);
        }

        .btn-submit:active:not(:disabled) {
            transform: translateY(1px);
        }

        .btn-submit:disabled {
            background: linear-gradient(135deg, #ccc, #e0e0e0);
            color: #999;
            cursor: not-allowed;
            transform: none;
            box-shadow: none;
        }

    .spinner {
        width: 18px;
        height: 18px;
        border: 2px solid rgba(255,255,255,0.4);
        border-top-color: #fff;
        border-radius: 50%;
        animation: spinAnim 0.7s linear infinite;
        display: inline-block;
    }

    @@keyframes spinAnim {
        from {
            transform: rotate(0deg);
        }

        to {
            transform: rotate(360deg);
        }
    }

    .secure-note {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        text-align: center;
        font-size: 11.5px;
        color: #9ca0b3;
        margin: 14px 0 0;
    }

    .found-popup-overlay {
        position: fixed;
        inset: 0;
        background: rgba(15, 23, 42, 0.45);
        backdrop-filter: blur(2px);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 999;
    }

    .found-popup {
        background: #fff;
        border-radius: 22px;
        padding: 2rem 1.75rem 1.75rem;
        text-align: center;
        width: 320px;
        box-sizing: border-box;
        box-shadow: 0 20px 45px rgba(15, 23, 42, 0.35);
    }

    .found-icon-wrap {
        width: 56px;
        height: 56px;
        border-radius: 16px;
        background: #fee2e2;
        color: var(--navy);
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 14px;
    }

    .found-popup h3 {
        margin: 0 0 4px;
        font-size: 18px;
        font-weight: 700;
        color: #1a1a2e;
    }

    .found-sub {
        font-size: 12.5px;
        color: #9ca0b3;
        margin: 0 0 14px;
    }

    .found-info-box {
        display: flex;
        align-items: center;
        gap: 12px;
        text-align: left;
        background: linear-gradient(135deg, #fef2f2, #eef2ff);
        border-radius: 16px;
        padding: 14px;
        margin-bottom: 16px;
    }

    .found-avatar {
        flex-shrink: 0;
        width: 46px;
        height: 46px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--navy-light), var(--red));
        color: #fff;
        font-weight: 700;
        font-size: 17px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .found-details {
        display: flex;
        flex-direction: column;
        gap: 2px;
        min-width: 0;
    }

        .found-details strong {
            font-size: 14px;
            color: #1a1a2e;
        }

    .found-email {
        font-size: 12px;
        color: #8a8fa3;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .found-phone {
        display: flex;
        align-items: center;
        gap: 4px;
        font-size: 12px;
        color: #8a8fa3;
    }

    .found-question {
        font-size: 12.5px;
        color: #777;
        margin: 0 0 1.25rem;
        line-height: 1.4;
    }

    .found-actions {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .btn-secondary-found {
        width: 100%;
        height: 44px;
        border-radius: 12px;
        border: none;
        background: transparent;
        color: #8a8fa3;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
    }

        .btn-secondary-found:hover:not(:disabled) {
            color: #555;
        }
</style>
