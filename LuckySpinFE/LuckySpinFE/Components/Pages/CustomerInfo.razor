@page "/customer-info"
@rendermode InteractiveServer
@using LuckySpinFE.Dto
@using System.Text.RegularExpressions
@inject LuckySpinFE.Services.LuckySpinApiClient ApiClient
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="spin-page">
    <div class="card">
        <div class="card-header">
            <div class="icon-wrap">📋</div>
            <h2 class="card-title">Thông tin khách hàng</h2>
            <p class="card-sub">Điền thông tin để nhận mã quay thưởng</p>
        </div>

        <div class="field">
            <label>
                <span class="field-icon">👤</span>
                Họ và tên <span class="req">*</span>
            </label>
            <input @bind="request.FullName" @bind:event="oninput"
                   class="@(submitted && string.IsNullOrWhiteSpace(request.FullName) ? "has-error" : "")"
                   placeholder="Nguyễn Văn A" />
            @if (submitted && string.IsNullOrWhiteSpace(request.FullName))
            {
                <div class="err-hint">⚠ Vui lòng nhập họ tên.</div>
            }
        </div>

        <div class="field">
            <label>
                <span class="field-icon">📞</span>
                Số điện thoại <span class="req">*</span>
            </label>
            <input @bind="request.Phone" @bind:event="oninput"
                   class="@(submitted && (string.IsNullOrWhiteSpace(request.Phone) || !IsPhoneValid()) ? "has-error" : "")"
                   placeholder="0901234456" />

            @* Case 1: Bỏ trống số điện thoại *@
            @if (submitted && string.IsNullOrWhiteSpace(request.Phone))
            {
                <div class="err-hint">⚠ Vui lòng nhập số điện thoại.</div>
            }
            @* Case 2: Có nhập nhưng chứa ký tự lạ (chữ hoặc ký tự đặc biệt) *@
            else if (!string.IsNullOrWhiteSpace(request.Phone) && !IsPhoneValid())
            {
                <div class="err-hint">⚠ Số điện thoại không hợp lệ (chỉ được chứa các chữ số).</div>
            }
        </div>

        <div class="field">
            <label>
                <span class="field-icon">✉️</span>
                Email <span class="req">*</span>
            </label>
            <input @bind="request.Email" @bind:event="oninput"
                   class="@(submitted && string.IsNullOrWhiteSpace(request.Email) ? "has-error" : "")"
                   placeholder="example@gmail.com" />
            @if (submitted && string.IsNullOrWhiteSpace(request.Email))
            {
                <div class="err-hint">⚠ Vui lòng nhập email hợp lệ.</div>
            }
        </div>

        <div class="field">
            <label>
                <span class="field-icon">📍</span>
                Địa chỉ
            </label>
            <input @bind="request.Address" placeholder="Quận 2, TP.HCM" />
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="global-err">@errorMessage</div>
        }

        <button class="btn-submit" @onclick="Submit" disabled="@isLoading">
            @if (isLoading)
            {
                <span class="spinner"></span>
                <span>Đang xử lý...</span>
            }
            else
            {
                <span>Tiếp tục →</span>
            }
        </button>
    </div>

    @if (showFoundPopup && respone != null)
    {
        <div class="found-popup-overlay">
            <div class="found-popup">
                <span class="big-emoji">🔍</span>
                <h3>Đã tìm thấy tài khoản</h3>
                <p class="found-info">
                    Số điện thoại này đã có tài khoản:<br />
                    <strong>@respone.FullName</strong><br />
                    @respone.Email<br />
                </p>
                <p class="found-question">Bạn có muốn cập nhật lại thông tin theo tài khoản này không?</p>
                <div class="found-actions">
                    <button class="btn-submit" @onclick="ConfirmUseFoundAccount" disabled="@isLoading">Có, cập nhật</button>
                    <button class="btn-secondary-found" @onclick="DeclineFoundAccount" disabled="@isLoading">Không, giữ thông tin đã nhập</button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private bool showFoundPopup = false;

    private PostCustomerRequest request = new();
    private GetAccountByPhoneRespone respone = new();

    private bool accountAlreadyExists = false;

    private bool submitted = false;
    private bool isLoading = false;
    private string errorMessage = "";

    private bool IsPhoneValid()
    {
        if (string.IsNullOrWhiteSpace(request.Phone)) return false;
        // Regex này đảm bảo chuỗi chỉ gồm các chữ số, độ dài từ 9 đến 11 ký tự (chuẩn SĐT Việt Nam)
        return Regex.IsMatch(request.Phone, @"^[0-9]{9,11}$");
    }

    private async Task Submit()
    {
        submitted = true;

        if (string.IsNullOrWhiteSpace(request.FullName) ||
            string.IsNullOrWhiteSpace(request.Phone) ||
            !IsPhoneValid() ||
            string.IsNullOrWhiteSpace(request.Email))
            return;

        isLoading = true;
        errorMessage = "";

        try
        {
            var foundCustomer = await ApiClient.GetCustomerByPhoneAsync(request.Phone);

            if (foundCustomer != null)
            {
                accountAlreadyExists = true;
                respone.Id = foundCustomer.Id;
                respone.FullName = foundCustomer.Name;
                respone.Email = foundCustomer.Mail;
                respone.Address = foundCustomer.Address;

                isLoading = false;
                showFoundPopup = true;
                return;
            }

            await CreateSessionAndNavigate();
        }
        catch (Exception ex)
        {
            errorMessage = $"Lỗi: {ex.Message}";
            isLoading = false;
        }
    }

    private async Task ConfirmUseFoundAccount()
    {
        if (respone == null) return;

        request.FullName = respone.FullName;
        request.Phone = respone.Phone;
        request.Email = respone.Email;
        request.Address = respone.Address;

        showFoundPopup = false;
        await CreateSessionAndNavigate();
    }

    private async Task DeclineFoundAccount()
    {
        showFoundPopup = false;
        accountAlreadyExists = false;
        await CreateSessionAndNavigate();
    }

    private async Task CreateSessionAndNavigate()
    {
        isLoading = true;
        errorMessage = "";

        try
        {
            if (accountAlreadyExists)////tìm thấy tk
            {
                await JS.InvokeVoidAsync("localStorage.setItem", "customerId", respone.Id);
                Nav.NavigateTo($"/spin-test?customerId={respone.Id}");
                return;
            }


            var customerId = await ApiClient.CreateWinnerSessionAsync(request);

            await JS.InvokeVoidAsync("localStorage.setItem", "customerId", customerId);

            Nav.NavigateTo($"/spin-test?customerId={customerId}");
        }
        catch (Exception ex)
        {
            errorMessage = $"Lỗi: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
}

<style>
    :global(body), :global(.page), :global(main) {
        margin: 0 !important;
        padding: 0 !important;
        overflow: hidden !important;
    }

    .spin-page {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        width: 100vw;
        height: 100vh;
        background: linear-gradient(135deg, #FF6B35 0%, #F7C59F 40%, #FFBE0B 70%, #FB5607 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1rem;
        overflow: hidden;
        box-sizing: border-box;
    }

        .spin-page::before,
        .spin-page::after {
            content: "";
            position: absolute;
            border-radius: 50%;
            opacity: 0.15;
            pointer-events: none;
        }

        .spin-page::before {
            width: 350px;
            height: 350px;
            background: #fff;
            top: -100px;
            left: -100px;
        }

        .spin-page::after {
            width: 250px;
            height: 250px;
            background: #FFBE0B;
            bottom: -50px;
            right: -50px;
        }

    .card {
        background: #fff;
        border-radius: 24px;
        padding: 2.25rem 2rem 2rem;
        width: 100%;
        max-width: 440px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
        position: relative;
        z-index: 1;
        box-sizing: border-box;
    }

    .card-header {
        text-align: center;
        margin-bottom: 2rem;
    }

    .icon-wrap {
        width: 68px;
        height: 68px;
        border-radius: 50%;
        background: linear-gradient(135deg, #fff3e0, #ffe0b2);
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 14px;
        font-size: 30px;
        border: 2px solid #FFBE0B;
        box-shadow: 0 4px 10px rgba(255, 190, 11, 0.2);
    }

    .card-title {
        font-size: 24px;
        font-weight: 700;
        letter-spacing: -0.3px;
        margin: 0;
        background: linear-gradient(90deg, #FB5607, #FFBE0B);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .card-sub {
        font-size: 13.5px;
        color: #777;
        margin: 6px 0 0;
    }

    .field {
        margin-bottom: 1.25rem;
    }

        .field label {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 13px;
            font-weight: 600;
            color: #444;
            margin-bottom: 6px;
        }

    .field-icon {
        font-size: 14px;
    }

    .req {
        color: #FB5607;
        font-size: 12px;
    }

    .field input {
        width: 100%;
        height: 46px;
        border: 1.5px solid #e5e5e5;
        border-radius: 12px;
        padding: 0 16px;
        font-size: 14.5px;
        color: #222;
        outline: none;
        transition: all .2s ease;
        background: #f9f9f9;
        box-sizing: border-box;
    }

        .field input:focus {
            border-color: #FB5607;
            background: #fff;
            box-shadow: 0 0 0 4px rgba(251, 86, 7, 0.1);
        }

        .field input.has-error {
            border-color: #e24b4b;
            background: #fff8f8;
        }

            .field input.has-error:focus {
                box-shadow: 0 0 0 4px rgba(226, 75, 75, 0.1);
            }

    .err-hint {
        font-size: 12px;
        color: #e24b4b;
        margin-top: 5px;
        display: flex;
        align-items: center;
        gap: 4px;
        font-weight: 500;
    }

    .global-err {
        font-size: 13px;
        color: #e24b4b;
        margin: 12px 0;
    }

    .btn-submit {
        width: 100%;
        height: 52px;
        border-radius: 14px;
        border: none;
        background: linear-gradient(135deg, #FB5607 0%, #FFBE0B 100%);
        color: #fff;
        font-size: 16px;
        font-weight: 700;
        cursor: pointer;
        letter-spacing: .3px;
        transition: all .2s ease;
        margin-top: 1.5rem;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        box-shadow: 0 4px 15px rgba(251, 86, 7, 0.3);
    }

        .btn-submit:hover:not(:disabled) {
            opacity: .95;
            transform: translateY(-1px);
            box-shadow: 0 6px 20px rgba(251, 86, 7, 0.4);
        }

        .btn-submit:active:not(:disabled) {
            transform: translateY(1px);
        }

        .btn-submit:disabled {
            background: linear-gradient(135deg, #ccc, #e0e0e0);
            color: #999;
            cursor: not-allowed;
            transform: none;
            box-shadow: none;
        }

    .spinner {
        width: 18px;
        height: 18px;
        border: 2px solid rgba(255,255,255,0.4);
        border-top-color: #fff;
        border-radius: 50%;
        animation: spinAnim 0.7s linear infinite;
        display: inline-block;
    }

    @@keyframes spinAnim {
        from {
            transform: rotate(0deg);
        }

        to {
            transform: rotate(360deg);
        }
    }








    .found-popup-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.55);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 999;
    }

    .found-popup {
        background: #fff;
        border-radius: 20px;
        padding: 2rem 1.75rem;
        text-align: center;
        width: 320px;
        box-sizing: border-box;
    }

    .found-info {
        font-size: 14px;
        color: #444;
        margin-bottom: 12px;
        line-height: 1.5;
    }

    .found-question {
        font-size: 13px;
        color: #777;
        margin-bottom: 1.25rem;
    }

    .found-actions {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .btn-secondary-found {
        width: 100%;
        height: 44px;
        border-radius: 12px;
        border: 1.5px solid #e5e5e5;
        background: #fff;
        color: #777;
        font-size: 13.5px;
        font-weight: 600;
        cursor: pointer;
    }
</style>