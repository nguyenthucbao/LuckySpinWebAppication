@page "/customer-info"
@rendermode InteractiveServer
@using LuckySpinFE.Dto
@inject LuckySpinFE.Services.LuckySpinApiClient ApiClient
@inject NavigationManager Nav

<div class="spin-page">
    <div class="card">
        <div class="card-header">
            <div class="icon-wrap">📋</div>
            <h2 class="card-title">Thông tin khách hàng</h2>
            <p class="card-sub">Điền thông tin để nhận mã quay thưởng</p>
        </div>

        <div class="steps">
            <div class="step">
                <div class="step-dot active">1</div>
                <div class="step-label active">Thông tin</div>
            </div>
            <div class="step-line"></div>
            <div class="step">
                <div class="step-dot inactive">2</div>
                <div class="step-label">Mã quay</div>
            </div>
            <div class="step-line"></div>
            <div class="step">
                <div class="step-dot inactive">3</div>
                <div class="step-label">Quay thưởng</div>
            </div>
        </div>

        <div class="field">
            <label>
                <span class="field-icon">👤</span>
                Họ và tên <span class="req">*</span>
            </label>
            <input @bind="request.FullName" @bind:event="oninput"
                   class="@(submitted && string.IsNullOrWhiteSpace(request.FullName) ? "has-error" : "")"
                   placeholder="Nguyễn Văn A" />
            @if (submitted && string.IsNullOrWhiteSpace(request.FullName))
            {
                <div class="err-hint">⚠ Vui lòng nhập họ tên.</div>
            }
        </div>

        <div class="field">
            <label>
                <span class="field-icon">📞</span>
                Số điện thoại <span class="req">*</span>
            </label>
            <input @bind="request.Phone" @bind:event="oninput"
                   class="@(submitted && string.IsNullOrWhiteSpace(request.Phone) ? "has-error" : "")"
                   placeholder="0901234456" />
            @if (submitted && string.IsNullOrWhiteSpace(request.Phone))
            {
                <div class="err-hint">⚠ Vui lòng nhập số điện thoại.</div>
            }
        </div>

        <div class="field">
            <label>
                <span class="field-icon">✉️</span>
                Email <span class="req">*</span>
            </label>
            <input @bind="request.Email" @bind:event="oninput"
                   class="@(submitted && string.IsNullOrWhiteSpace(request.Email) ? "has-error" : "")"
                   placeholder="example@gmail.com" />
            @if (submitted && string.IsNullOrWhiteSpace(request.Email))
            {
                <div class="err-hint">⚠ Vui lòng nhập email hợp lệ.</div>
            }
        </div>

        <div class="field">
            <label>
                <span class="field-icon">📍</span>
                Địa chỉ
            </label>
            <input @bind="request.Address" placeholder="Quận 2, TP.HCM" />
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="global-err">@errorMessage</div>
        }

        <button class="btn-submit" @onclick="Submit" disabled="@isLoading">
            @if (isLoading)
            {
                <span class="spinner"></span>
                <span>Đang xử lý...</span>
            }
            else
            {
                <span>Tiếp tục →</span>
            }
        </button>
    </div>
</div>

@code {
    private PostCustomerRequest request = new();
    private bool submitted = false;
    private bool isLoading = false;
    private string errorMessage = "";

    private async Task Submit()
    {
        submitted = true;

        if (string.IsNullOrWhiteSpace(request.FullName) ||
            string.IsNullOrWhiteSpace(request.Phone) ||
            string.IsNullOrWhiteSpace(request.Email))
            return;

        isLoading = true;
        errorMessage = "";

        try
        {
            var sessionId = await ApiClient.CreateWinnerSessionAsync(request);
            Nav.NavigateTo($"/spin-test?customerId={sessionId}");
        }
        catch (Exception ex)
        {
            errorMessage = $"Lỗi: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
}

<style>
    .spin-page {
        min-height: 100vh;
        background: linear-gradient(135deg, #FF6B35 0%, #F7C59F 40%, #FFBE0B 70%, #FB5607 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem 1rem;
        position: relative;
        overflow: hidden;
    }

        .spin-page::before,
        .spin-page::after {
            content: "";
            position: absolute;
            border-radius: 50%;
            opacity: 0.18;
            pointer-events: none;
        }

        .spin-page::before {
            width: 300px;
            height: 300px;
            background: #fff;
            top: -80px;
            left: -80px;
        }

        .spin-page::after {
            width: 200px;
            height: 200px;
            background: #FFBE0B;
            bottom: -40px;
            right: -40px;
        }

    .card {
        background: #fff;
        border-radius: 24px;
        padding: 2rem 2rem 1.75rem;
        width: 100%;
        max-width: 420px;
        position: relative;
        z-index: 1;
    }

    .card-header {
        text-align: center;
        margin-bottom: 1.5rem;
    }

    .icon-wrap {
        width: 64px;
        height: 64px;
        border-radius: 50%;
        background: linear-gradient(135deg, #fff3e0, #ffe0b2);
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 12px;
        font-size: 28px;
        border: 2px solid #FFBE0B;
    }

    .card-title {
        font-size: 22px;
        font-weight: 700;
        letter-spacing: -0.3px;
        background: linear-gradient(90deg, #FB5607, #FFBE0B);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .card-sub {
        font-size: 13px;
        color: #888;
        margin-top: 4px;
    }

    .steps {
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 1.75rem;
    }

    .step {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 4px;
    }

    .step-dot {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
        font-weight: 700;
    }

        .step-dot.active {
            background: linear-gradient(135deg, #FB5607, #FFBE0B);
            color: #fff;
        }

        .step-dot.done {
            background: #FB5607;
            color: #fff;
        }

        .step-dot.inactive {
            background: #f0f0f0;
            color: #aaa;
        }

    .step-label {
        font-size: 10px;
        color: #aaa;
        font-weight: 500;
        white-space: nowrap;
    }

        .step-label.active {
            color: #FB5607;
        }

    .step-line {
        width: 40px;
        height: 2px;
        background: #f0f0f0;
        margin-bottom: 18px;
        flex-shrink: 0;
    }

        .step-line.done {
            background: linear-gradient(90deg, #FB5607, #FFBE0B);
        }

    .field {
        margin-bottom: 1.1rem;
    }

        .field label {
            display: flex;
            align-items: center;
            gap: 5px;
            font-size: 12.5px;
            font-weight: 600;
            color: #555;
            margin-bottom: 5px;
        }

    .field-icon {
        font-size: 14px;
    }

    .req {
        color: #FB5607;
        font-size: 11px;
    }

    .field input {
        width: 100%;
        height: 44px;
        border: 1.5px solid #e5e5e5;
        border-radius: 10px;
        padding: 0 14px;
        font-size: 14px;
        color: #222;
        outline: none;
        transition: border-color .2s, background .2s;
        background: #fafafa;
    }

        .field input:focus {
            border-color: #FB5607;
            background: #fff;
        }

        .field input.has-error {
            border-color: #e24b4b;
            background: #fff8f8;
        }

    .err-hint {
        font-size: 11.5px;
        color: #e24b4b;
        margin-top: 4px;
        display: flex;
        align-items: center;
        gap: 3px;
    }

    .global-err {
        font-size: 12.5px;
        color: #e24b4b;
        margin-top: 8px;
        padding: 8px 12px;
        background: #fff0f0;
        border-radius: 8px;
        border-left: 3px solid #e24b4b;
    }

    .btn-submit {
        width: 100%;
        height: 52px;
        border-radius: 14px;
        border: none;
        background: linear-gradient(135deg, #FB5607 0%, #FFBE0B 100%);
        color: #fff;
        font-size: 15px;
        font-weight: 700;
        cursor: pointer;
        letter-spacing: .3px;
        transition: opacity .2s, transform .15s;
        margin-top: 1.25rem;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

        .btn-submit:hover:not(:disabled) {
            opacity: .92;
            transform: scale(1.01);
        }

        .btn-submit:active:not(:disabled) {
            transform: scale(.98);
        }

        .btn-submit:disabled {
            background: linear-gradient(135deg, #ccc, #e0e0e0);
            color: #999;
            cursor: not-allowed;
            transform: none;
        }

    .spinner {
        width: 16px;
        height: 16px;
        border: 2px solid rgba(255,255,255,0.4);
        border-top-color: #fff;
        border-radius: 50%;
        animation: spinAnim 0.7s linear infinite;
        display: inline-block;
    }

    @@keyframes spinAnim {
        from {
            transform: rotate(0deg);
        }

        to {
            transform: rotate(360deg);
        }
    }
</style>
