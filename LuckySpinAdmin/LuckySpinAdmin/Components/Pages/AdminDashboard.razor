    // ===================== MODAL: ADD STORE =====================
    private bool showAddStoreModal = false;
    private MockStore newStore = new();

    private void ConfirmAddStore()
    {
        if (string.IsNullOrWhiteSpace(newStore.Id) || string.IsNullOrWhiteSpace(newStore.StoreLocate))
            return;

        // TODO: Call API POST /api/stores/addstore here, dùng newStore làm body.
        // Sau khi API trả về thành công mới thêm vào danh sách hiển thị:
        Stores.Add(new MockStore
        {
            Id = newStore.Id,
            StoreLocate = newStore.StoreLocate,
            CampaignCount = 0,
            SpinCount = 0,
            TotalAmount = 0
        });

        newStore = new MockStore();
        showAddStoreModal = false;
    }

    // ===================== MODAL: EDIT LOCATION =====================
    private bool showEditLocationModal = false;
    private MockStore? editingStore;

    private void OpenEditLocation(MockStore store)
    {
        // Copy để không sửa trực tiếp danh sách gốc trước khi xác nhận
        editingStore = new MockStore { Id = store.Id, StoreLocate = store.StoreLocate };
        showEditLocationModal = true;
    }

    private void ConfirmEditLocation()
    {
        if (editingStore == null) return;

        // TODO: Call API PUT /api/stores/{storeId} here với editingStore.StoreLocate
        var target = Stores.FirstOrDefault(s => s.Id == editingStore.Id);
        if (target != null)
            target.StoreLocate = editingStore.StoreLocate;

        showEditLocationModal = false;
        editingStore = null;
    }

    // ===================== MODAL: DELETE STORE =====================
    private bool showDeleteConfirmModal = false;
    private MockStore? deletingStore;

    private void OpenDeleteConfirm(MockStore store)
    {
        deletingStore = store;
        showDeleteConfirmModal = true;
    }

    private void ConfirmDeleteStore()
    {
        if (deletingStore == null) return;

        // TODO: Call API DELETE /api/stores/{storeId} here
        Stores.Remove(deletingStore);

        showDeleteConfirmModal = false;
        deletingStore = null;
    }

    // ===================== MODAL: ASSIGN CAMPAIGN =====================
    private bool showAssignCampaignModal = false;
    private HashSet<string> pickedCampaignIds = new();

    private void ToggleCampaignPick(string campaignId, bool isChecked)
    {
        if (isChecked) pickedCampaignIds.Add(campaignId);
        else pickedCampaignIds.Remove(campaignId);
    }

    private void ConfirmAssignCampaigns()
    {
        if (SelectedStoreId == null) return;

        // TODO: Call API POST /api/stores/{storeId}/campaigns here với danh sách pickedCampaignIds
        foreach (var campaignId in pickedCampaignIds)
        {
            StoreCampaignLinks.Add(new StoreCampaignLink { StoreId = SelectedStoreId, CampaignId = campaignId });
        }

        pickedCampaignIds.Clear();
        showAssignCampaignModal = false;
    }

    // ===================== PRIZE: SAVE PROBABILITY WEIGHT =====================
    private string? savingPrizeId;
    private string saveToast = "";

    private async Task SavePrizeWeight(MockPrize prize)
    {
        savingPrizeId = prize.Id;
        StateHasChanged();

        // TODO: Call API PUT /api/prizes/{prizeId}/weight here với prize.EditedWeight
        await Task.Delay(400); // giả lập độ trễ gọi API

        prize.ProbabilityWeight = prize.EditedWeight;
        savingPrizeId = null;
        saveToast = $"Đã lưu tỷ lệ cho \"{prize.Name}\"";

        StateHasChanged();
        _ = ClearToastAfterDelay();
    }

    private async Task ClearToastAfterDelay()
    {
        await Task.Delay(2500);
        saveToast = "";
        StateHasChanged();
    }
